{
  "name": "mobilimaz-backend",
  "version": "1.0.0",
  "description": "Mobilim.az Marketplace Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node -e \"if (process.env.NODE_ENV === 'production') { console.error('SEED BLOCKED IN PRODUCTION'); process.exit(1); }\" && node seed.js",
    "seed_admin": "node seed_admin.js",
    "create-indexes": "node scripts/create-indexes.js",
    "create-admin": "node create_admin.js",
    "promote-admin": "node promote_admin.js",
    "test:security": "node tests/security-regression.test.js",
    "check": "node --check server.js && node --check controllers/authController.js && node --check controllers/adController.js && node --check controllers/storeController.js && node --check controllers/adminController.js && node --check middlewares/authMiddleware.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs mobilimaz-backend",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.59.0",
    "@sentry/profiling-node": "^10.59.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "rate-limit-redis": "^4.3.1",
    "rate-limiter-flexible": "^11.2.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
}
