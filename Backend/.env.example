PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
# Tests use mongodb-memory-server in memory and never connect to MONGODB_URI.
MONGO_TEST_URI=memory
# IMPORTANT: Transactions require a MongoDB Replica Set. If running locally, you must initiate a replica set (e.g., using run-rs or mongod --replSet).
# Generate a secure 64-byte random hex string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_64_byte_random_hex_string
# Optional versioned access-token keys for rotation (JSON object or comma-separated secrets). Keep previous keys only during migration.
JWT_ACTIVE_KID=primary
JWT_ACCESS_KEYS={"primary":"CHANGE_ME_64_CHAR_SECRET_HERE","previous":"CHANGE_ME_OLD_KEY"}
# Set to 'true' in production after all active users rotate to disable hardcoded fallback secrets completely
DISABLE_LEGACY_JWT_FALLBACK=false
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_FROM_JWT_SECRET
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SAME_SITE=lax
# Set only when the API and frontend intentionally share a parent domain.
REFRESH_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=csrfToken
CSRF_COOKIE_SAME_SITE=lax
CSRF_ALLOW_NO_ORIGIN=false
MAX_REFRESH_SESSIONS=5
# revoke_oldest is the default behavior; set reject_new to block new logins at the limit.
MAX_REFRESH_SESSION_POLICY=revoke_oldest
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MS=900000
RESET_TOKEN_TTL_MS=900000
PASSWORD_RESET_RATE_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_IDENTIFIER_RATE_LIMIT=3
PASSWORD_RESET_EMAIL_COOLDOWN_MS=600000
REGISTRATION_RATE_WINDOW_MS=3600000
REGISTRATION_IP_RATE_LIMIT=8
REGISTRATION_IDENTIFIER_RATE_LIMIT=3
VERIFICATION_RATE_WINDOW_MS=900000
VERIFICATION_IP_RATE_LIMIT=10
VERIFICATION_IDENTIFIER_RATE_LIMIT=3
VERIFICATION_RESEND_COOLDOWN_MS=60000
ACCOUNT_CHANGE_RATE_WINDOW_MS=900000
ACCOUNT_CHANGE_RATE_LIMIT=10
EMAIL_CHANGE_TOKEN_TTL_MS=1800000
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502,https://mobilim.az,https://www.mobilim.az,https://mobilim-az.onrender.com
# Optional legacy alias (CORS_ORIGINS takes precedence)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502,https://mobilim.az,https://www.mobilim.az,https://mobilim-az.onrender.com
CORS_ALLOW_NO_ORIGIN=false
TRUST_PROXY_HOPS=
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
UPLOAD_RATE_LIMIT=20
MAX_UPLOAD_FILE_SIZE=5242880
MAX_UPLOAD_FILES=10
MAX_UPLOAD_FIELDS=20
MAX_UPLOAD_PARTS=35
MAX_UPLOAD_HEADER_PAIRS=100
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_TEXT_FIELD_LENGTH=5000
PAYMENT_SESSION_TTL_MS=3600000
# Payment provider: 'mock' for sandbox/dev, or live provider (e.g. 'payriff') in production
PAYMENT_PROVIDER=mock
PAYMENT_RECONCILIATION_ENABLED=true # pending ödənişləri avtomatik yoxla
PAYRIFF_API_URL=https://api.payriff.com
# Alias: PAYRIFF_BASE_URL (köhnə)
PAYRIFF_BASE_URL=https://api.payriff.com
PAYRIFF_API_KEY=your_payriff_api_key
# Payriff API Authorization secret; keep separate from the callback secret.
PAYRIFF_SECRET=your_payriff_secret
# Secret used only to verify Payriff callback HMAC signatures.
PAYRIFF_WEBHOOK_SECRET=your_payriff_webhook_secret
# Exact callback signature header name supplied by Payriff; required for live callbacks.
PAYRIFF_SIGNATURE_HEADER=x-payriff-signature
PAYRIFF_MERCHANT_ID=
MERCHANT_ID=
KAPITAL_API_KEY=
# Callback secret for mock or other providers; Payriff uses PAYRIFF_WEBHOOK_SECRET.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET
WEBHOOK_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET
# Allow mock sandbox signature ('mock-sandbox-signature') strictly for non-production development testing
ALLOW_MOCK_SIGNATURE=true
PAYMENT_PROVIDER_ORIGINS=
API_PUBLIC_ORIGIN=https://api.mobilim.az
# CSRF_SECRET=... generate: openssl rand -hex 32
CSRF_SECRET=CHANGE_ME_64_CHAR_HEX_CSRF_SECRET
# Orphaned uploads cleanup (set to false to disable automated deletion)
CLEANUP_ORPHANS=false
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_IMG_SRC=
CSP_FONT_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_ANCESTORS=
TWO_FACTOR_ISSUER=MobilimAZ
# Generate: openssl rand -hex 32 (64-hex string)
TWO_FACTOR_SECRET_ENCRYPTION_KEY=your-64-hex-string-here-generate-with-openssl-rand-hex-32
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_LOCK_TIME_MS=600000
REQUIRE_STORE_2FA=true

# Admin Seed
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# 2FA Feature Flags
EMAIL_OTP_ENABLED=false
SMS_OTP_ENABLED=false
SMS_DEV_MODE=false
TOTP_2FA_ENABLED=false
REQUIRE_ADMIN_2FA=false
# 2FA üçün 64 hex simvol: TWO_FACTOR_SECRET_ENCRYPTION_KEY=
TWO_FACTOR_SECRET_ENCRYPTION_KEY=

# Provider Configs
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@mobilim.az
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@mobilim.az
# SMS_API_KEY=
# SMS_API_URL=

# Redis Cache & Rate Limiting
# Production-da mütləq, yoxsa rate limit worker-lər arasında paylaşılmır (PM2 cluster)
REDIS_URL=redis://localhost:6379
REDIS_TTL_SEC=300

# PM2 Deployment Settings
# Number of cluster instances: 'max' for all CPU cores, or specific integer (e.g., 2, 4)
PM2_INSTANCES=max

# PRODUCTION: PAYMENT_PROVIDER=payriff tələb olunur, local dev üçün mock normaldır
# Merchant ID boş olarsa prod-da payriff order merchantId olmadan göndəriləcək, lazımdırsa doldur

# E2E & Testing Config (Dedicated disposable test environment, NEVER production)
BASE_URL=http://127.0.0.1:5500
BACKEND_URL=http://localhost:5000
E2E_EMAIL=test_user@mobilim.az
E2E_PASSWORD=TestPass123!@#
MONGODB_URI_TEST=memory



